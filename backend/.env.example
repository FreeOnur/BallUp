# Copy to .env and fill in. Never commit .env.
# Local Postgres comes from deploy/compose/compose.dev.yml (ADR 0008).

# --- App ---
BALLUP_ENV=development
BALLUP_LOG_LEVEL=INFO

# --- Auth ---
# Eigene Auth nach ADR 0010. Die Werte (JWT, Pepper) kommen mit dem Auth-Modul,
# noch nicht hier.

# --- Database ---
BALLUP_DATABASE_URL=postgresql+asyncpg://ballup:ballup@127.0.0.1:5432/ballup

# --- Redis (cache, rate limits, job queue) ---
BALLUP_REDIS_URL=redis://localhost:6379/0

# --- Hetzner Object Storage (ADR 0013) ---
BALLUP_S3_ENDPOINT=
BALLUP_S3_BUCKET=
BALLUP_S3_ACCESS_KEY_ID=
BALLUP_S3_SECRET_ACCESS_KEY=

# --- Observability (OpenTelemetry → Tempo) ---
OTEL_SERVICE_NAME=ballup-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
