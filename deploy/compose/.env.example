# Copy to deploy/compose/.env on the server. Never commit .env.

# --- Images ---
BALLUP_API_IMAGE=docker.io/<dockerhub-user>/ballup-api:latest

# --- Domains (Caddy issues TLS certificates automatically) ---
ACME_EMAIL=
API_DOMAIN=api.ballup.app
GRAFANA_DOMAIN=grafana.ballup.app
STATUS_DOMAIN=status.ballup.app

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- API runtime (same keys as backend/.env.example) ---
BALLUP_ENV=production
BALLUP_LOG_LEVEL=INFO
BALLUP_OIDC_ISSUER=
BALLUP_OIDC_AUDIENCE=
BALLUP_OIDC_JWKS_URL=
BALLUP_DATABASE_URL=
BALLUP_REDIS_URL=redis://redis:6379/0
BALLUP_S3_ENDPOINT=
BALLUP_S3_BUCKET=
BALLUP_S3_ACCESS_KEY_ID=
BALLUP_S3_SECRET_ACCESS_KEY=
OTEL_SERVICE_NAME=ballup-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
