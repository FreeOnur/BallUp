        <mxCell parent="1" id="note_court_active_users" value="Regel: user_id ist PK → ein User kann nur auf &lt;b&gt;einem&lt;/b&gt; Court gleichzeitig aktiv sein. Neuer Check-in ersetzt den alten, expires_at = Auto-Check-out." vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;">
