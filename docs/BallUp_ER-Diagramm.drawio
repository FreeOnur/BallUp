        <mxCell parent="1" id="note_court_photos" value="Regel: neues Foto = &lt;i&gt;pending&lt;/i&gt;. KI prüft zuerst (ai_score), unsichere Fälle prüft ein Admin (reviewed_by). Nur &lt;i&gt;approved&lt;/i&gt; wird angezeigt." vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;">
