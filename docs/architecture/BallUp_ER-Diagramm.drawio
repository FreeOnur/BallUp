yle="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_court_active_users_0__court_id" target="t_courts_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_court_active_users_0__user_id" target="t_users_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_media_2__uploaded_by" target="t_users_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_media_2__reviewed_by" target="t_users_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Regeln&lt;/b&gt;&lt;br&gt;• Court wird approved, sobald 20 Nutzer zugestimmt haben.&lt;br&gt;• court_active_users: PK = user_id → ein Nutzer ist max. auf 1 Court. Zeile wird beim Auschecken gelöscht → kein Standortverlauf.&lt;br&gt;• media: alle Uploads (Court-Fotos, Avatare, Clan, Posts). Erst KI-Prüfung, am Anfang zusätzlich Admin → nur approved wird angezeigt.&lt;br&gt;• Max. 5 Fotos pro Court (position 1–5)." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1630" y="130" width="380" height="244" as="geometry"/></mxCell></root></mxGraphM