        <mxCell parent="1" id="note_clan_members" value="Regel: user_id ist PK → max. 1 Clan pro User. Gründen geht mehrmals, aber wer einen neuen Clan gründet oder joint, verlässt automatisch den alten." vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;">
