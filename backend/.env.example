# Copy to .env and fill in. Never commit .env.

# --- App ---
BALLUP_ENV=development
BALLUP_LOG_LEVEL=INFO

# --- Auth (OIDC, self-hosted identity provider – the API only validates tokens) ---
BALLUP_OIDC_ISSUER=
BALLUP_OIDC_AUDIENCE=
BALLUP_OIDC_JWKS_URL=

# --- Database (engine still open, see Notion "Stack") ---
BALLUP_DATABASE_URL=

# --- Redis (cache, rate limits, job queue) ---
BALLUP_REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible, EU – provider still open) ---
BALLUP_S3_ENDPOINT=
BALLUP_S3_BUCKET=
BALLUP_S3_ACCESS_KEY_ID=
BALLUP_S3_SECRET_ACCESS_KEY=

# --- Observability (OpenTelemetry → Tempo) ---
OTEL_SERVICE_NAME=ballup-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
