Fill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_matchmaking_tickets_0__team_id" target="t_teams_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e50" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_matchmaking_tickets_0__matched_game_id" target="t_games_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Regeln&lt;/b&gt;&lt;br&gt;• Privates Game: visibility = private → nur über invite_code (Link/QR) oder Einladung in game_invites.&lt;br&gt;• game_invites deckt beides ab: Einladung (invite) und Beitrittsanfrage am Court (join_request).&lt;br&gt;• Ergebnis: 1 Spieler trägt ein (reported_by), 1 Spieler der Gegenseite bestätigt (confirmed_by). Abweichung → disputed.&lt;br&gt;• Elo getrennt pro Saison und Format (1v1 / 3v3 / 5v5).&lt;br&gt;• Voll → Warteliste (waitlisted + Position). Wer zusammen beitritt, teilt eine party_id und landet im selben Team; der Rest wird nach Skill ausgeglichen." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1630" y="130" width="380" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p_teams" name="Teams &amp; Turniere"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BallUp ER · Teams &amp; Turniere (Phase 3)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="36" as="geometry"/></mxCell><mxCell id="sub" value="PK fett · FK kursiv · grau gestrichelt = Tabelle aus anderem Bereich · Linienenden: Krähenfuß = viele, Strich = genau 1, Kreis = optional" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="24" as="geometry"/></mxCell><mxCell id="t_users_0" value="users  (→ Account)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=1;arcSize=4;fontSize=13;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="54" as="geometry"/></mxCell><mxCell id="t_users_0__id" value="PK  id : id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=1;" vertex="1" parent="t_users_0"><mxGeometry y="30" width="360" height="24" as="geometry"/></mxCell><mxCell id="t_media_0" value="media  (→ Courts &amp; Medien)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=1;arcSize=4;fontSize=13;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="360" height="54" as="geometry"/></mxCell><mxCell id="t_media_0__id" value="PK  id : id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;html=1;fontStyle=1;" vertex="1" parent="t_media_0"><mxGeometry y="30" width="360" height="24" as="geometry"/></mxCell><mxCell id="t_teams_1" value="teams" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizont