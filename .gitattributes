# Normalize all text files to LF in the repo and in the working tree
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must stay LF
gradlew text eol=lf
*.sh text eol=lf

# draw.io diagrams: never touch line endings (content must stay byte-identical)
*.drawio -text
*.dtmp -text

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.mp4 binary
*.lottie binary

# Generated / lock files: collapse in diffs
uv.lock linguist-generated=true -diff
mobile/gradle/wrapper/gradle-wrapper.jar linguist-generated=true
*.xcodeproj/** linguist-generated=true
