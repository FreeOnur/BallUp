{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Root domain: placeholder page and /.well-known/ for Android App Links and iOS Universal Links.
{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	root * /srv/site
	@aasa path /.well-known/apple-app-site-association
	header @aasa Content-Type application/json
	file_server {
		hide README.md
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# REST (/v1, /admin/v1) and WebSockets
{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy api:8000
}

{$GRAFANA_DOMAIN} {
	import security_headers
	reverse_proxy grafana:3000
}

# Only the public status page (slug "ballup"). The Uptime Kuma admin UI and its first-run setup are not
# reachable from the internet – use an SSH tunnel to 127.0.0.1:3001 on the server instead.
{$STATUS_DOMAIN} {
	import security_headers

	@status_page path /status/* /api/status-page/* /api/badge/* /assets/* /upload/* /icon.svg /favicon.ico /apple-touch-icon*.png /manifest.json
	handle @status_page {
		reverse_proxy uptime-kuma:3001
	}
	handle / {
		redir * /status/ballup
	}
	handle {
		respond 404
	}
}
