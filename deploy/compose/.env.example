# Vorlage für deploy/compose/.env auf dem Server (/opt/ballup/deploy/compose/.env).
# Anlegen: npm run install:server · Bearbeiten: npm run ssh, dann nano .env · Nie committen.
# [Pflicht] = ohne den Wert startet der Stack nicht. [später] = erst nötig, wenn das Feature gebaut ist.

# --- Image ---
# Setzt das Deploy-Skript bei jedem Deploy selbst (genaue Version); das hier ist nur der Fallback.
BALLUP_API_IMAGE=docker.io/onurballup/ballup-api:latest

# --- Domains + HTTPS (Caddy) ---
# [Pflicht] E-Mail für Let's Encrypt (Warnungen zu ablaufenden Zertifikaten).
ACME_EMAIL=
# [Pflicht] Je ein DNS-A-Record auf die Server-IP 46.224.171.6, bevor der Stack startet.
API_DOMAIN=api.ballup.app
GRAFANA_DOMAIN=grafana.ballup.app
STATUS_DOMAIN=status.ballup.app

# --- Grafana (Dashboards) ---
GRAFANA_ADMIN_USER=admin
# [Pflicht] Starkes Passwort, z. B. openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# --- API ---
BALLUP_ENV=production
BALLUP_LOG_LEVEL=INFO
# [später] Auth (ADR 0010): wird mit dem auth-Modul durch eigene Schlüssel (JWT, Pepper) ersetzt.
BALLUP_OIDC_ISSUER=
BALLUP_OIDC_AUDIENCE=
BALLUP_OIDC_JWKS_URL=
# [später] PostgreSQL + PostGIS (ADR 0008), z. B. postgresql+asyncpg://ballup:<passwort>@postgres:5432/ballup
BALLUP_DATABASE_URL=
# Redis läuft im Stack, nicht ändern.
BALLUP_REDIS_URL=redis://redis:6379/0
# [später] Hetzner Object Storage (ADR 0013): Cloud Console → Object Storage → Bucket + S3-Credentials.
BALLUP_S3_ENDPOINT=
BALLUP_S3_BUCKET=
BALLUP_S3_ACCESS_KEY_ID=
BALLUP_S3_SECRET_ACCESS_KEY=

# --- Tracing (Tempo im Stack, nicht ändern) ---
OTEL_SERVICE_NAME=ballup-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
