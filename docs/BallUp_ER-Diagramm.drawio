        <mxCell parent="1" id="note_tournament_matches" value="Bracket: match_advancements sagt, in welches Match (und als Team A oder B) der Gewinner aufrückt. game_id verknüpft das echte Spiel → Ergebnis/ELO laufen über games." vertex="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;">
