# Database (Postgres + PostGIS via Docker Compose)
POSTGRES_USER=baller
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baller
DATABASE_URL=postgresql://baller:change-me@db:5432/baller

# Auth (JWT)
JWT_SECRET=change-me-min-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Backblaze B2 (presigned uploads — required in production)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=courtfinder-images
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_REGION=us-west-002

# Resend (email verification + password reset)
RESEND_API_KEY=
RESEND_FROM=noreply@ballup.net
