etry"/></mxCell><mxCell id="e4" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERmandOne;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_profiles_2__user_id" target="t_users_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_profiles_2__avatar_media_id" target="t_media_3__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERmandOne;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_user_settings_2__user_id" target="t_users_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_subscriptions_2__user_id" target="t_users_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e110" style="edgeStyle=entityRelationEdgeStyle;rounded=0;fontSize=11;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;startSize=10;endSize=10;" edge="1" parent="1" source="t_user_passkeys_0__user_id" target="t_users_1__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Regeln&lt;/b&gt;&lt;br&gt;• Login selbst gebaut: E-Mail + Passwort (Argon2id + Salt + Pepper), Google/Apple über OpenID Connect (je Anbieter eine Zeile in auth_identities), optional Passkey.&lt;br&gt;• auth_sessions = Login-Sitzung pro Gerät. Refresh-Token nur als Hash, Rotation bei jeder Nutzung, Ablauf nach 30 Tagen Inaktivität.&lt;br&gt;• devices = Handy des Nutzers inkl. Push-Token; neues Gerät → Login-Warnung.&lt;br&gt;• Konto löschen: persönliche Daten hart gelöscht, Beiträge für andere bleiben als „Gelöschter Spieler“." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2160" y="130" width="380" height="244" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p_social" name="Social &amp; Moderation"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BallUp ER · Social &amp; Moderation (Phase 1–3)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="36" as="geometry"/></mxCell><mxCell id="sub" value="PK fett · FK kursiv · grau gestrichelt = Tabelle aus anderem Bereich · Linienenden: Krähenfuß = viele, Strich = genau 1, Kreis = optional" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="24" as="geometry"/></mxCell><mxCell id="t_friendships_0" value="friendships" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=1;arcSize=4;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="174" as="geometry"/></mxCell><mxCell id="t_friendships_0__id" value="PK  id : id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;ht